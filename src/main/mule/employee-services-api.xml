				doc:name="Log response" />

			<error-handler>
				<on-error-propagate type="DB:CONNECTIVITY" doc:name="Database Connectivity Error">
					<logger level="ERROR"
						message="Database connectivity error for employee: #[vars.employeeId] - #[error.description]"
						doc:name="Log DB connectivity error" />
					<set-payload
						value='{"error": "Database connection failed", "employeeId": "#[vars.employeeId]", "details": "Unable to connect to database"}'
						doc:name="Set DB connectivity error payload" />
					<set-variable variableName="httpStatus" value="503" doc:name="Set 503 status" />
				</on-error-propagate>
				<on-error-propagate type="DB:*" doc:name="Database Error">
					<logger level="ERROR"
						message="Database error for employee: #[vars.employeeId] - #[error.description]"
						doc:name="Log DB error" />
					<set-payload
						value='{"error": "Database query failed", "employeeId": "#[vars.employeeId]", "details": "#[error.description]"}'
						doc:name="Set DB error payload" />
					<set-variable variableName="httpStatus" value="500" doc:name="Set 500 status" />
				</on-error-propagate>
				<on-error-propagate type="TRANSFORMATION" doc:name="Transformation Error">
					<logger level="ERROR"
						message="Transformation error for employee: #[vars.employeeId] - #[error.description]"
						doc:name="Log transformation error" />
					<set-payload
						value='{"error": "Data transformation failed", "employeeId": "#[vars.employeeId]"}'
						doc:name="Set transformation error payload" />
					<set-variable variableName="httpStatus" value="500" doc:name="Set 500 status" />
				</on-error-propagate>
				<on-error-propagate type="ANY" doc:name="General Error">
					<logger level="ERROR"
						message="Unexpected error for employee: #[vars.employeeId] - #[error.description]"
						doc:name="Log general error" />
					<set-payload
						value='{"error": "Internal server error", "employeeId": "#[vars.employeeId]", "details": "An unexpected error occurred"}'
						doc:name="Set general error payload" />
					<set-variable variableName="httpStatus" value="500" doc:name="Set 500 status" />
				</on-error-propagate>
			</error-handler>
		</try>
	</flow>

	<!-- Endpoint: POST /{employeeId}/pto/schedule -->
	<flow
		name="post:\(employeeId)\pto\schedule:application\json:employee-services-api-config">
		<ee:transform doc:name="Extract Request Data">
			<ee:variables>
				<ee:set-variable
					variableName="employeeId">attributes.uriParams.'employeeId'</ee:set-variable>
				<ee:set-variable
					variableName="startDate">payload.startDate</ee:set-variable>
				<ee:set-variable
					variableName="endDate">payload.endDate</ee:set-variable>
			</ee:variables>
		</ee:transform>
		<try doc:name="Try">
			<db:update doc:name="Insert or Update PTO Schedule"
				config-ref="PostgreSQL_Configuration">
				<db:sql><![CDATA[
INSERT INTO employee_pto (employee_id, next_pay_date)
VALUES (:employeeId, :endDate)
ON CONFLICT (employee_id) DO UPDATE SET
next_pay_date = :endDate
]]></db:sql>
				<db:input-parameters><![CDATA[#{employeeId: vars.employeeId, endDate: vars.endDate}]]></db:input-parameters>
			</db:update>

			<ee:transform doc:name="Success Response">
				<ee:message>
					<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
employeeId: vars.employeeId,
startDate: vars.startDate,
endDate: vars.endDate,
status: "success",
message: "PTO scheduled successfully"
}]]></ee:set-payload>
				</ee:message>
			</ee:transform>
			<set-variable variableName="httpStatus" value="200" doc:name="Set 200 status" />

			<error-handler>
				<on-error-propagate type="ANY" doc:name="General Error">
					<set-payload
						value='{"error": "Failed to schedule PTO", "employeeId": "#[vars.employeeId]"}'
						doc:name="Set error payload" />
					<set-variable variableName="httpStatus" value="500" doc:name="Set 500 status" />
				</on-error-propagate>
			</error-handler>
		</try>
	</flow>

</mule>